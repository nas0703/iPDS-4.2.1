{
  "name": "react-example",
  "private": true,
  "version": "4.2.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.cjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/serverless.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=api/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:auth": "tsx scripts/tests/auth_bypass_test.ts",
    "test:auth-bypass": "tsx scripts/tests/auth_bypass_test.ts",
    "test:security": "tsx scripts/tests/modules/security_compliance.test.ts",
    "test:pruning": "tsx scripts/tests/pruning_routes_test.ts",
    "test:cron": "tsx scripts/tests/cron_process_jobs.test.ts",
    "test:load": "tsx scripts/tests/load_test.ts",
    "test:load:staging": "tsx scripts/tests/staging_1500_user_load_test.ts",
    "test:all": "tsx scripts/tests/run_all_tests.ts",
    "test:regression": "tsx scripts/tests/run_all_tests.ts",
    "ci:pipeline": "npm run lint && npm run test:all && npm run dr:check && npm run build",
    "dr:check": "tsx scripts/dr/ci_preflight.ts",
    "dr:backup": "tsx scripts/dr/backup.ts",
    "dr:backup:verify": "tsx scripts/dr/verify_backup.ts",
    "dr:reconcile": "tsx scripts/dr/reconciliation.ts",
    "dr:restore:preflight": "tsx scripts/dr/restore_preflight.ts",
    "dr:restore": "tsx scripts/dr/restore.ts",
    "dr:restore:verify": "tsx scripts/dr/verify_recovery.ts",
    "dr:storage:verify": "tsx scripts/dr/storage_verify.ts",
    "dr:verify": "tsx scripts/dr/verify_recovery.ts",
    "dr:smoke": "tsx scripts/dr/app_smoke_test.ts",
    "dr:failures": "tsx scripts/dr/failure_tests.ts",
    "dr:drill": "tsx scripts/dr/drill_orchestrator.ts",
    "dr:report": "tsx scripts/dr/drill_orchestrator.ts",
    "dr:remediate": "tsx scripts/dr/remediation_orchestrator.ts",
    "dr:live:test": "tsx scripts/dr/live_recovery_app_test.ts",
    "dr:rpo:assess": "tsx scripts/dr/rpo_assessment.ts",
    "dr:storage:objects": "tsx scripts/dr/storage_object_recovery.ts",
    "dr:rpo:final": "tsx scripts/dr/final_rpo_validation.ts"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dom-to-image": "^2.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-is": "^19.2.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
