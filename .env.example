# AI Studio Environment Variables
GEMINI_API_KEY=
APP_URL=

# Supabase Credentials & Durability Architecture
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_POOLED_URL= # Connection Pooler URL (PgBouncer/Supavisor port 6543)
SUPABASE_READ_REPLICA_URL= # Optional Read Replica URL for Read-Write Separation
SUPABASE_READ_REPLICA_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional: externalized identity credential overrides (JSON map of PIN -> profile).
# Lets operators rotate PINs/passwords without a code deploy. Keep out of source control.
IPDS_IDENTITY_OVERRIDES_JSON=

# Automation & Cron Security
CRON_SECRET= # Vercel Cron Secret for /api/cron/process-jobs authorization

# Observability & Incident Alerting
ALERT_WEBHOOK_URL= # Webhook URL for alerting (Slack / Discord / Teams / PagerDuty)

# Optional Overrides (Have built-in fallbacks):
# IPDS_CREDENTIALS_JSON= (Optional: already bundled securely in src/server/config/credentials.hashes.json keyed by operator_id)
# IPDS_SEED_CREDENTIALS_INPUT_JSON= (Optional: input shape for scripts/seed_credentials.ts: '[{"pin":"...","password":"...","app_role":"staff","operator_id":"STF-TGL-01","operator_name":"...","kiosk_id":"...","estate_id":"FPM_TUNGGAL","station_name":"..."}]')
# ALLOWED_ORIGINS= (Optional: default patterns for felda.gov.my, vercel.app, run.app already configured)


